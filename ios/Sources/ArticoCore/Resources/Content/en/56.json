xt":"paint the wall","emphasis":true},{"text":", "},{"text":"repair the fence","emphasis":true},{"text":", "},{"text":"put up shelves","emphasis":true},{"text":", "},{"text":"replace the carpet","emphasis":true},{"text":", and "},{"text":"remove the wallpaper","emphasis":true},{"text":". They help explain a requested job in Chapters 38 and 61."}],"span":[37,37],"phraseIds":["ch56-p194096787737178","ch56-p213124395818075","ch56-p24100135623579","ch56-p123760098681096","ch56-p211464445690050"]}],"line":31,"ja":"","theme":"home-vocabulary"},{"id":"56-words","title":"Words & phrases","blocks":[{"id":"56-glossary","type":"vocabulary","phraseIds":["ch56-v0","ch56-v1","ch56-v2","ch56-v3"]}]}],"practice":[{"id":"56-practice-0","title":"Take your turn","blocks":[{"id":"ch56-b8","type":"list","ordered":true,"items":[{"number":1,"runs":[{"text":"Identify the words: below-ground space; passage between rooms; appliance for clothes; furniture with drawers."}],"id":"ch56-b8-0"},{"number":2,"runs":[{"text":"Use this practice home: apartment; one bedroom; kitchen and living room; balcony; no garage. Describe it in three sentences."}],"id":"ch56-b8-1"},{"number":3,"runs":[{"text":"Choose three items you need for a bedroom or kitchen. Explain what each is for."}],"id":"ch56-b8-2"},{"number":4,"runs":[{"text":"State a home-project request using "},{"text":"We need someone to...","emphasis":true},{"text":" and one combination above."}],"id":"ch56-b8-3"}],"span":[41,44]}],"line":41,"ja":"","theme":"home-vocabulary","answers":[{"id":"ch56-b9","type":"answer","runs":[{"text":"Sample possibilities:","emphasis":true},{"text":" "},{"text":"Basement, hallway, washing machine, dresser.","emphasis":true},{"text":" “It's a one-bedroom apartment. It has a kitchen and a living room. There's a balcony, but no garage.” / “We need someone to repair the fence.”"}],"span":[46,46]},{"id":"ch56-b10","type":"explanation","runs":[{"text":"Cover the lists later and describe the same home using the words you 