":"ch08-line54"},{"id":"ch08-p235493614998293","en":"I owe you one","section":"08-study-2","context":"Gifts and compliments","kind":"phrase","studyId":"ch08-p235493614998293"},{"id":"ch08-p58543491598040","en":"Thanks a lot","section":"08-study-3","context":"Optional: The same words, a different intention","kind":"phrase","studyId":"ch08-p58543491598040"},{"id":"ch08-p8864887277601","en":"You left without telling me? Thanks a lot","section":"08-study-3","context":"Optional: The same words, a different intention","kind":"phrase","studyId":"ch08-p8864887277601"},{"id":"ch08-p208750873144422","en":"I'm upset that you left without telling me","section":"08-study-3","context":"Optional: The same words, a different intention","kind":"phrase","studyId":"ch08-p208750873144422"},{"art":"word-umbrella.svg","id":"ch08-v0","en":"umbrella","section":"words","context":"Something you hold over yourself to keep off rain.","kind":"word","studyId":"ch08-v0"},{"art":"word-gift.svg","id":"ch08-v1","en":"birthday gift","section":"words","context":"Something given to a person to celebrate their birthday.","kind":"word","studyId":"ch08-v1"},{"art":"word-thanks.svg","id":"ch08-v2","en":"Thanks for waiting.","section":"words","context":"Thank someone for the time they spent waiting for you.","kind":"word","studyId":"ch08-v2"}],"studyPhrases":[{"id":"ch08-p64466082672555","en":"Thanks","section":"08-study-0","context":"Name what you appreciate","kind":"word"},{"id":"ch08-p167252145005773","en":"Thank you","section":"08-study-0","context":"Name what you appreciate","kind":"word"},{"id":"ch08-p119882666982005","en":"Thanks for your help.","section":"08-study-0","context":"Name what you appreciate","kind":"phrase"},{"id":"ch08-p90432578889427","en":"Thank you for waiting.","section":"08-study-0","context":"Name what you appreciate","kind":"phrase"},{"id":"ch08-p116787530686140","en":"Thanks for the ride.","section":"08-study-0","context":"Name what you appreciate","kind":"phrase"},{"id":"ch08-p