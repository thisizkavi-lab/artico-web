am.","section":"02-study-2","context":"Eli · Connect two people","kind":"phrase","speaker":"Eli","portrait":"portrait-278299.svg","studyId":"ch02-line50"},{"id":"ch02-p263898734650894","en":"It's nice to finally meet in person","section":"02-study-2","context":"Connect two people","kind":"phrase","studyId":"ch02-p263898734650894"},{"id":"ch02-p88747932635278","en":"Could you say your name again?","section":"02-study-2","context":"Connect two people","kind":"phrase","studyId":"ch02-p88747932635278"},{"id":"ch02-p245678920191676","en":"How do you spell it?","section":"02-study-2","context":"Connect two people","kind":"phrase","studyId":"ch02-p245678920191676"},{"art":"word-friend.svg","id":"ch02-v0","en":"friend","section":"words","context":"Someone you know well and like spending time with.","kind":"word","studyId":"ch02-v0"},{"art":"word-coworker.svg","id":"ch02-v1","en":"colleague","section":"words","context":"Someone you work with.","kind":"word","studyId":"ch02-v1"},{"art":"word-name-tag.svg","id":"ch02-v2","en":"name","section":"words","context":"The word or words used to identify a person.","kind":"word","studyId":"ch02-v2"},{"art":"word-camera.svg","id":"ch02-v3","en":"photography class","section":"words","context":"A class where people learn to take photographs.","kind":"word","studyId":"ch02-v3"}],"studyPhrases":[{"id":"ch02-p112965777075329","en":"I'm","section":"02-study-0","context":"Say who you are","kind":"word"},{"id":"ch02-p244176047606341","en":"My name is","section":"02-study-0","context":"Say who you are","kind":"phrase"},{"id":"ch02-line10","en":"Hi, I'm Maya. I'm a friend of Jordan's.","section":"02-study-0","context":"Maya · Say who you are","kind":"phrase","speaker":"Maya","portrait":"portrait-8855619.svg"},{"id":"ch02-line11","en":"I'm Eli. Nice to meet you.","section":"02-study-0","context":"Eli · Say who you are","kind":"phrase","speaker":"Eli","portrait":"portrait-278299.svg"},{"id":"ch02-line12","en":"You too.","section":"02-study-0","cont