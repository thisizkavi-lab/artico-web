nge","kind":"word"},{"id":"ch72-p30202454322379","en":"charger","section":"72-study-2","context":"Pack and arrange","kind":"word"},{"id":"ch72-p150753636412421","en":"sunscreen","section":"72-study-2","context":"Pack and arrange","kind":"word"},{"id":"ch72-p202063200624933","en":"book a flight","section":"72-study-2","context":"Pack and arrange","kind":"phrase"},{"id":"ch72-p137304014517652","en":"make a reservation","section":"72-study-2","context":"Pack and arrange","kind":"phrase"},{"id":"ch72-p227870665056677","en":"rent a car","section":"72-study-2","context":"Pack and arrange","kind":"phrase"},{"id":"ch72-p142295680077700","en":"reserve a campsite","section":"72-study-2","context":"Pack and arrange","kind":"phrase"},{"id":"ch72-p214246186970954","en":"pack a suitcase","section":"72-study-2","context":"Pack and arrange","kind":"phrase"},{"id":"ch72-p226281433027763","en":"exchange money","section":"72-study-2","context":"Pack and arrange","kind":"word"},{"id":"ch72-p178189919247654","en":"check in","section":"72-study-2","context":"Pack and arrange","kind":"word"},{"id":"ch72-p39374461677539","en":"check out","section":"72-study-2","context":"Pack and arrange","kind":"word"},{"id":"ch72-p98967503068586","en":"Go abroad","section":"72-study-2","context":"Pack and arrange","kind":"word"},{"id":"ch72-p76592222476796","en":"life jacket","section":"72-study-3","context":"Activities and sights","kind":"word"},{"art":"word-suitcase.svg","id":"ch72-v0","en":"suitcase","section":"words","context":"A useful word for vacation vocabulary.","kind":"word"},{"art":"word-passport.svg","id":"ch72-v1","en":"passport","section":"words","context":"Pack and arrange","kind":"word"},{"art":"word-tent.svg","id":"ch72-v2","en":"campsite","section":"words","context":"A useful word for vacation vocabulary.","kind":"word"},{"art":"word-map.svg","id":"ch72-v3","en":"sightseeing","section":"words","context":"A useful word for vacation vocabulary.","kind":"word"}]}
