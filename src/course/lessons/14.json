":"ch14-v0","en":"parent","section":"words","context":"A useful word for family and relationships.","kind":"word"},{"art":"word-family.svg","id":"ch14-v1","en":"sibling","section":"words","context":"A useful word for family and relationships.","kind":"word"},{"art":"word-family.svg","id":"ch14-v2","en":"stepsister","section":"words","context":"Step- and half- relationships","kind":"word"},{"art":"word-family.svg","id":"ch14-v3","en":"half-brother","section":"words","context":"Step- and half- relationships","kind":"word"}]}
