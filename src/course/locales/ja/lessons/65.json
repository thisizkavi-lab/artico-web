d","ja":""},{"id":"ch65-p66286701979029","en":"e-ticket","section":"65-study-3","context":"チケット、書類、動作","kind":"word","ja":""},{"id":"ch65-p268237320151484","en":"driver's license","section":"65-study-3","context":"チケット、書類、動作","kind":"word","ja":""},{"id":"ch65-p225676225375625","en":"discount card","section":"65-study-3","context":"チケット、書類、動作","kind":"word","ja":""},{"id":"ch65-p75820455373682","en":"board / get on a bus, train, or plane","section":"65-study-3","context":"チケット、書類、動作","kind":"phrase","ja":""},{"id":"ch65-p272484777785041","en":"get off","section":"65-study-3","context":"チケット、書類、動作","kind":"word","ja":""},{"id":"ch65-p237761465577790","en":"get in a car or taxi","section":"65-study-3","context":"チケット、書類、動作","kind":"phrase","ja":""},{"id":"ch65-p204565252242113","en":"get out","section":"65-study-3","context":"チケット、書類、動作","kind":"word","ja":""},{"id":"ch65-p65907514812375","en":"takes off","section":"65-study-3","context":"チケット、書類、動作","kind":"word","ja":""},{"id":"ch65-p192107237241905","en":"lands","section":"65-study-3","context":"チケット、書類、動作","kind":"word","ja":""},{"id":"ch65-p239124685602352","en":"Tap your card","section":"65-study-3","context":"チケット、書類、動作","kind":"phrase","ja":""},{"id":"ch65-p169231369066247","en":"Give someone a ride","section":"65-study-3","context":"チケット、書類、動作","kind":"phrase","ja":""},{"id":"ch65-p118398942200832","en":"departure board","section":"65-study-3","context":"チケット、書類、動作","kind":"word","ja":""},{"id":"ch65-p50483124832861","en":"Delayed","section":"65-study-3","context":"チケット、書類、動作","kind":"word","ja":""},{"id":"ch65-p199400837934088","en":"canceled","section":"65-study-3","context":"チケット、書類、動作","kind":"word","ja":""},{"art":"word-bus.svg","id":"ch65-v0","en":"bus","section":"words","context":"バス","kind":"word","ja":""},{"art":"word-train.svg","id":"ch65-v1","en":"subway","section":"words","context":"地下鉄","kind":"word","ja":""},{"art":"word-ticket.svg","id":"ch65-v2","en":"ticket","section":"words","context":"乗車券",