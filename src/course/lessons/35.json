":"words","context":"A useful word for at the market.","kind":"word"},{"art":"word-cart.svg","id":"ch35-v1","en":"a basket","section":"words","context":"A useful word for at the market.","kind":"word"},{"art":"word-lamp.svg","id":"ch35-v2","en":"lamp","section":"words","context":"A useful word for at the market.","kind":"word"},{"art":"word-receipt.svg","id":"ch35-v3","en":"How much are they?","section":"words","context":"A useful word for at the market.","kind":"word"}]}
